    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".sokol-slider-box", {
            loop: true,
            autoplay: {
                delay: 3500,
                disableOnInteraction: false,
            },
            pagination: {
                el: ".slider-dots",
                clickable: true,
            },
            speed: 600,
        });

        $('#openDrawerBtn').click(function() {
            $('#drawerOverlay').fadeIn(200);
            $('#drawerMenu').css('right', '0');
        });

        $('#closeDrawerBtn, #drawerOverlay').click(function() {
            $('#drawerOverlay').fadeOut(200);
            $('#drawerMenu').css('right', '-320px');
        });

        $('#serviceSearchInput, #desktopSearch').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $(".cat-card, .service-item").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        function loadStats() {
            $.ajax({
                url: 'api/get_user_stats.php',
                method: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (data && data.success) {
                        if (data.user_balance !== undefined) {
                            $('#balance-display, #hero-balance').text(data.user_balance);
                        }
                        if (data.total_orders !== undefined && data.total_orders > 0) {
                            $('#totalOrders').text(data.total_orders + ' টি');
                        }
                        if (data.completed_orders !== undefined && data.completed_orders > 0) {
                            $('#completedOrders').text(data.completed_orders + ' টি');
                        }
                    }
                }
            });
        }

        $(document).ready(function() {
            loadStats();
            setInterval(loadStats, 10000);
        });
    </script>
</body>
</html>