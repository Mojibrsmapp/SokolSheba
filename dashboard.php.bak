<?php 
ini_set('display_errors', 0);
error_reporting(E_ALL);

session_start();
include_once("includes/configuration.php");

if (isset($_SESSION['user_token'])) {
    $token_user = $_SESSION['user_token'];
    
    // SQL Schema: users টেবিলে image কলাম রয়েছে
    $stmt = $conn->prepare("SELECT id, balance, email, name, token, mobile, image FROM users WHERE token = ?");
    if ($stmt) {
        $stmt->bind_param("s", $token_user);
        $stmt->execute();
        $result = $stmt->get_result();

        if ($result && $result->num_rows > 0) {
            $row = $result->fetch_assoc();
            $id = (int)$row["id"];
            $balance = $row["balance"];
            $email = $row["email"];
            $name = $row["name"];
            $token = $row["token"];
            $phone = $row["mobile"];
            $user_image = !empty($row["image"]) ? $row["image"] : "";
        } else {
            unset($_SESSION['user_token'], $_SESSION['user_id']);
            header("Location: index.php");
            exit();
        }
        $stmt->close();
    } else {
        die("Database Statement Error: " . $conn->error);
    }
} else {
    header("Location: index.php");
    exit();
}

// মোট ও আজকের অর্ডার হিসাব (Safe Queries)
$total_orders_count = 0;
$today_orders_count = 0;
$esc_email = $conn->real_escape_string($email);

$q_ord1 = @$conn->query("SELECT COUNT(*) as total, SUM(CASE WHEN DATE(created_at) = CURDATE() THEN 1 ELSE 0 END) as today FROM orders WHERE user_id = $id");
if ($q_ord1 && $r1 = $q_ord1->fetch_assoc()) {
    $total_orders_count += (int)($r1['total'] ?? 0);
    $today_orders_count += (int)($r1['today'] ?? 0);
}

$q_ord2 = @$conn->query("SELECT COUNT(*) as total, SUM(CASE WHEN DATE(order_time) = CURDATE() THEN 1 ELSE 0 END) as today FROM order_list WHERE email = '$esc_email'");
if ($q_ord2 && $r2 = $q_ord2->fetch_assoc()) {
    $total_orders_count += (int)($r2['total'] ?? 0);
    $today_orders_count += (int)($r2['today'] ?? 0);
}

$q_sc = @$conn->query("SELECT COUNT(*) as total FROM server_copy WHERE user_mail = '$esc_email'");
if ($q_sc && $rsc = $q_sc->fetch_assoc()) { 
    $total_orders_count += (int)($rsc['total'] ?? 0); 
}

$q_tin = @$conn->query("SELECT COUNT(*) as total, SUM(CASE WHEN DATE(created_at) = CURDATE() THEN 1 ELSE 0 END) as today FROM tin_data WHERE user_email = '$esc_email'");
if ($q_tin && $rtin = $q_tin->fetch_assoc()) {
    $total_orders_count += (int)($rtin['total'] ?? 0);
    $today_orders_count += (int)($rtin['today'] ?? 0);
}

// প্রাইস লোড
$price_map = [];
$q_prices = @$conn->query("SELECT orderName, price FROM prices");
if ($q_prices) {
    while ($rp = $q_prices->fetch_assoc()) {
        $price_map[trim($rp['orderName'])] = (int)$rp['price'];
    }
}

// সাইট সেটিংস
$settings_data = [];
$q_set = @$conn->query("SELECT setting_key, setting_value FROM site_settings");
if ($q_set) {
    while ($rs = $q_set->fetch_assoc()) {
        $settings_data[$rs['setting_key']] = $rs['setting_value'];
    }
}
$support_num = !empty($settings_data['support_whatsapp_num']) ? $settings_data['support_whatsapp_num'] : '01964706489';
$whatsapp_link = !empty($settings_data['whatsapp_group']) ? $settings_data['whatsapp_group'] : 'https://wa.me/88' . preg_replace('/[^0-9]/', '', $support_num);
$telegram_link = !empty($settings_data['telegram_link']) ? $settings_data['telegram_link'] : 'https://t.me/Sheba_kit';

// ডাইনামিক স্লাইডার
$slider_images = [
    '/assets/slider/1.jpg',
    '/assets/slider/2.jpg'
];

$slider_dir = $_SERVER['DOCUMENT_ROOT'] . '/assets/slider/';
if (is_dir($slider_dir)) {
    $found_files = glob($slider_dir . '*.{jpg,jpeg,png,webp,gif}', GLOB_BRACE);
    if (!empty($found_files)) {
        $slider_images = [];
        foreach ($found_files as $file_path) {
            $slider_images[] = '/assets/slider/' . basename($file_path);
        }
    }
}
