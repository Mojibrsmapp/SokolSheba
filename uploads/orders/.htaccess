# Uploaded order documents live here (NID photos, PDFs, ...).
# Make sure nothing in this folder can ever be executed as a script.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
